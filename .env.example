# Copy to .env and fill in. Never commit or share the filled-in file.
ESCRIPTORIUM_URL=https://escriptorium.umd.edu

# Preferred: your API key (eScriptorium profile page -> "API key")
ESCRIPTORIUM_TOKEN=

# Alternative to a token (does not work for single-sign-on accounts):
# ESCRIPTORIUM_USERNAME=
# ESCRIPTORIUM_PASSWORD=
